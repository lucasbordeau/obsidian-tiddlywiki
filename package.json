{
  "name": "tiddlywiki-import-export",
  "version": "1.1.0",
  "description": "Import/Export TiddlyWiki",
  "main": "main.js",
  "scripts": {
    "test": "jest --config jest.config.js",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "node scripts/lint/lint.mjs",
    "format": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"eslint-rules/**/*.mjs\" AGENTS.md CONTRIBUTING.md \"docs/development/**/*.md\" \"skills/**/*.md\"",
    "build:core": "node scripts/build/build-core.mjs",
    "demo:tw": "node scripts/manual/open-demo-tiddlywiki.mjs",
    "demo:tw:empty": "node scripts/manual/open-demo-tiddlywiki.mjs --empty",
    "dev:obsidian": "node scripts/manual/open-dev-obsidian.mjs",
    "test:demo": "node --test scripts/manual/__tests__/*.test.mjs",
    "test:lint": "node --test scripts/lint/__tests__/test-*.mjs",
    "test:dev": "node --test scripts/build/__tests__/*.test.mjs",
    "test:bundles": "node scripts/validation/__tests__/core-bundles.test.mjs",
    "check": "npm run typecheck && npm test -- --runInBand && npm run test:lint && npm run test:dev && npm run lint && npm run build:core && npm run test:bundles && npm run build && npm run test:demo"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.4.3",
    "@types/jest": "^29.4.0",
    "@types/markdown-it": "14.1.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "eslint": "8.34.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "fast-check": "3.23.2",
    "jest": "^29.4.3",
    "obsidian": "latest",
    "prettier": "^3.4.2",
    "tiddlywiki": "5.4.1",
    "ts-jest": "^29.0.5",
    "tslib": "2.4.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "dotenv": "^16.4.7",
    "entities": "4.5.0",
    "markdown-it": "14.1.0",
    "mime-types": "^2.1.35",
    "yaml": "2.8.1"
  }
}
